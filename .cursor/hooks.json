{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-pr-template.sh"
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/enforce-pr-template.sh",
        "matcher": "Shell",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/enforce-pr-template.sh",
        "matcher": "gh",
        "failClosed": true
      }
    ]
  }
}
